fn sum_where(a as int[1000], keep as fn(int) as bool) as int
    var t = 0
    for x in a
        if keep(x) then t += x
    end for
    return t
end fn
var a as int[1000]
for i in 0..1000
    a[i] = (i * 7919) mod 1000
end for
var t = 0
let lim = 500
for r in 0..300
    t += sum_where(a, fn(x) x > lim)
end for
print(t)
