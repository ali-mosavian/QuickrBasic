' PANGOLIN DASH: Pip the pangolin tears through the Amber Downs.
' Arrows run. Space, Z or Up jumps, curled. Down while running rolls;
' Down while still crouches: jump to wind up, let Down go to launch.
' M mutes, N turns the tune on; Esc leaves. SCREEN 13 on two pages: one drawn, one shown.
' Held keys come from the keyboard's port (60h); where it reads FFh,
' from INKEY$'s repeats. Physics in pixels and seconds, 60 steps a
' second; the pictures are DATA, drawn by tools/pangart.py.
DEFINT A-Z

' Pip. x, y: the feet. gsp: speed along the ground, ang its rise in
' radians, uphill to the right > 0. onloop: the loop it is on, + 1, th
' its angle round it from the bottom.
TYPE Hero
    x AS SINGLE
    y AS SINGLE
    vx AS SINGLE
    vy AS SINGLE
    gsp AS SINGLE
    ang AS SINGLE
    th AS SINGLE
    lastx AS SINGLE
    charge AS SINGLE
    inv AS SINGLE
    anim AS SINGLE
    deadT AS SINGLE
    idleT AS SINGLE
    ground AS INTEGER
    roll AS INTEGER
    jumped AS INTEGER
    crouch AS INTEGER
    charging AS INTEGER
    stun AS INTEGER
    face AS INTEGER
    skid AS INTEGER
    sprung AS INTEGER
    dead AS INTEGER
    onloop AS INTEGER
    win AS INTEGER
END TYPE

' Held keys, and jump's press since the last step.
TYPE Pad
    l AS INTEGER
    r AS INTEGER
    d AS INTEGER
    jump AS INTEGER
    hit AS INTEGER
    was AS INTEGER
    quit AS INTEGER
    start AS INTEGER
    mute AS INTEGER
END TYPE

TYPE Game
    mode AS INTEGER
    beads AS INTEGER
    lives AS INTEGER
    score AS LONG
    bonus AS LONG
    sig AS LONG
    clock AS SINGLE
    camx AS SINGLE
    camy AS SINGLE
    modeT AS SINGLE
    shake AS SINGLE
    homeX AS INTEGER
    homeY AS INTEGER
    page AS INTEGER
    quitting AS INTEGER
END TYPE

' A bead knocked loose: t its time left.
TYPE Loose
    x AS SINGLE
    y AS SINGLE
    vx AS SINGLE
    vy AS SINGLE
    t AS SINGLE
END TYPE

TYPE Part
    x AS SINGLE
    y AS SINGLE
    vx AS SINGLE
    vy AS SINGLE
    t AS SINGLE
    c AS INTEGER
END TYPE

' The world: MW by MH tiles of TS pixels; LW columns used. A tile's kind
' is its profile, Prof: each column's solid height from its bottom.
CONST SW = 320, SH = 200, TS = 16, MW = 800, MH = 30, NONE = 30000
CONST STEPT = 1! / 60!, PI = 3.141593
CONST GRAV = 750!, JUMPV = 330!, JUMPCUT = 160!, TOP = 360!
CONST RUNACC = 280!, DEC = 1800!, FRIC = 280!, AIRACC = 500!, SLOPE = 500!
CONST RFRIC = 60!, RDEC = 450!, RUPS = 300!, RDNS = 1100!, MAXV = 900!
CONST SPRINGV = 560!, CHARGE0 = 480!, CHARGEMAX = 360!, BOUNCEV = 330!
CONST BOOSTV = 660!, LOOPR = 48, LOOPIN = 330!, LOOPG = 400!, LD = 124
CONST HW = 7, HH = 24, STRIPH = 192, MIDH = 80
CONST MAXOBJ = 600, NLOOSE = 24, NPART = 48
CONST TITLE = 0, PLAYING = 1, CLEARED = 2, OVER = 3
CONST FIDLE = 0, FBLINK = 1, FTAP = 2, FRUN = 4, FDASH = 10, FBALL = 12
CONST FSKID = 16, FCROUCH = 17, FHURT = 18, FUP = 19, FWIN = 20, NF = 22

' What stands in the level, by x. From KLOOP on: scenery, drawn behind
' the ground.
CONST KBEAD = 1, KBUG = 2, KSPRING = 3, KMARK = 4, KBOOST = 5, KGOAL = 6, KPLAT = 7
CONST KLOOP = 8, KTREE = 9, KBUSH = 10, KFLOWER = 11, KROCK = 12, KTHORN = 13, KLAMP = 14

' Images in Img from At(k); a masked one's mask at k + 1. As pangart.py's.
CONST IBG = 0, IMID = 1, ISTRIP = 3, IDEEP = 4, ILOOP = 5, ITITLE = 7
CONST ITILE = 10, IEARTH = 30, IHERO = 34, IBEAD = IHERO + NF * 4
CONST IBUG = IBEAD + 8, ISPRING = IBUG + 8, IBOOST = ISPRING + 4, IMARK = IBOOST + 4
CONST IGOAL = IMARK + 4, ITREE = IGOAL + 8, IBUSH = ITREE + 2, IFLOWER = IBUSH + 2
CONST IROCK = IFLOWER + 4, ITHORN = IROCK + 2, ILAMP = ITHORN + 2, ITILT = ILAMP + 2
CONST IDASH = ITILT + 80
CONST ICARD = IDASH + 2, IGLYPH = ICARD + 2, NGLYPH = 24, IHUD = IGLYPH + NGLYPH * 4, NIMG = IHUD + 2
CONST HUDW = 108, HUDH = 40
CONST IMGSZ = 130000

CONST SCLEFT = 75, SCRIGHT = 77, SCUP = 72, SCDOWN = 80, SCSPACE = 57, SCZ = 44
CONST SJUMP = 0, SBEAD = 1, SHURT = 2, SSPRING = 3, SPOP = 4, SROLL = 5
CONST SCHARGE = 6, SLAUNCH = 7, SCLEAR = 8, SDIE = 9, SMARK = 10, SBOOST = 11

' The palette's ramps, dark to light, as pangart.py's.
CONST CHUD = 0, CWHITE = 1, CINK = 2, CYELLOW = 3, CRED = 4
