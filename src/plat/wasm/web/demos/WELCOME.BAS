' Welcome to QuickrBasic, in your browser.
' F5 runs this program. Alt opens the menus; File, Open lists the demos.
CLS
COLOR 14, 1
PRINT " QuickrBasic "
COLOR 7, 0
PRINT
PRINT "A modern remake of QBasic, QuickBasic and VBDos."
PRINT
FOR i = 1 TO 10
    PRINT i, i * i, SQR(i)
NEXT
PRINT
PRINT "Press any key to go back to the editor."
