' CHARLIE BARKLEY: Charlie the Maltese tears through the Amber Downs.
' Arrows run. Space, Z or Up jumps, curled. Down while running rolls;
' Down while still crouches: jump to wind up, let Down go to launch.
' M mutes, N turns the tune off; Esc leaves. SCREEN 13 on two pages: one drawn, one shown.
' Held keys come from the keyboard's port (60h); where it reads FFh,
' from INKEY$'s repeats. Physics in pixels and seconds, 60 steps a
' second; the pictures are DATA, drawn by tools/charlieart.py.
DEFINT A-Z

' Charlie. x, y: the feet. gsp: speed along the ground, ang its rise in
' radians, uphill to the right > 0. onloop: the loop it is on, + 1, th
' its angle round it from the bottom.
TYPE Hero
    x AS SINGLE
    y AS SINGLE
    vx AS SINGLE
    vy AS SINGLE
    gsp AS SINGLE
    ang AS SINGLE
    th AS SINGLE
    lastx AS SINGLE
    charge AS SINGLE
    inv AS SINGLE
    anim AS SINGLE
    deadT AS SINGLE
    idleT AS SINGLE
    ground AS INTEGER
    roll AS INTEGER
    jumped AS INTEGER
    crouch AS INTEGER
    charging AS INTEGER
    stun AS INTEGER
    face AS INTEGER
    skid AS INTEGER
    sprung AS INTEGER
    dead AS INTEGER
    onloop AS INTEGER
    win AS INTEGER
END TYPE

' Held keys, and jump's press since the last step.
TYPE Pad
    l AS INTEGER
    r AS INTEGER
    d AS INTEGER
    jump AS INTEGER
    hit AS INTEGER
    was AS INTEGER
    quit AS INTEGER
    start AS INTEGER
    mute AS INTEGER
END TYPE

TYPE Game
    mode AS INTEGER
    bones AS INTEGER
    lives AS INTEGER
    score AS LONG
    bonus AS LONG
    sig AS LONG
    clock AS SINGLE
    camx AS SINGLE
    camy AS SINGLE
    modeT AS SINGLE
    shake AS SINGLE
    homeX AS INTEGER
    homeY AS INTEGER
    page AS INTEGER
    quitting AS INTEGER
END TYPE

' A bone knocked loose: t its time left.
TYPE Loose
    x AS SINGLE
    y AS SINGLE
    vx AS SINGLE
    vy AS SINGLE
    t AS SINGLE
END TYPE

TYPE Part
    x AS SINGLE
    y AS SINGLE
    vx AS SINGLE
    vy AS SINGLE
    t AS SINGLE
    c AS INTEGER
END TYPE

' The world: MW by MH tiles of TS pixels; LW columns used. A tile's kind
' is its profile, Prof: each column's solid height from its bottom.
CONST SW = 320, SH = 200, TS = 16, MW = 800, MH = 30, NONE = 30000
CONST STEPT = 1! / 60!, PI = 3.141593
CONST GRAV = 750!, JUMPV = 330!, JUMPCUT = 160!, TOP = 360!
CONST RUNACC = 280!, DEC = 1800!, FRIC = 280!, AIRACC = 500!, SLOPE = 500!
