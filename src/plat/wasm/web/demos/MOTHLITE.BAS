CONST HOMEX = 85, ASPECT = 1.2!, STEPT = 1! / 120!
CONST NSTONE = 4, STONEW = 29, OVERHANG = 3
CONST CAPH = 7, GAP = 66, SPACING = 124, NKIND = 5
