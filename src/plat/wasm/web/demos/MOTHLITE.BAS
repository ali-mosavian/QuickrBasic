' MOTHLIGHT: a little moth's big day out.
' Space, Enter or Up flaps; M mutes; Esc quits.
' SCREEN 13 on two pages: one drawn, one shown.
' Each subsystem owns a record; World holds them
' all. The loop reads input, updates, then draws.

TYPE Moth
    x AS SINGLE
    y AS SINGLE
    vy AS SINGLE
    beat AS SINGLE
    boost AS SINGLE
    squash AS SINGLE
    behind AS INTEGER
END TYPE

TYPE Stone
    x AS SINGLE
    gap AS INTEGER
    passed AS INTEGER
    kind AS INTEGER
END TYPE

TYPE Spark
    x AS SINGLE
    y AS SINGLE
    vx AS SINGLE
    vy AS SINGLE
    life AS SINGLE
    born AS LONG
    hot AS INTEGER
    wide AS INTEGER
    warm AS INTEGER
    alive AS INTEGER
END TYPE

TYPE Burst
    n AS INTEGER
    spread AS SINGLE
    kick AS SINGLE
END TYPE

TYPE Fx
    flash AS SINGLE
    shake AS SINGLE
    pop AS SINGLE
END TYPE

TYPE Sky
    phase AS INTEGER
    fade AS SINGLE
    fadeTo AS SINGLE
    ease AS SINGLE
END TYPE

' The music: the song and its beat; the sky's mood,
' latched each bar, and the score, for the layers.
TYPE Song
    id AS INTEGER
    beat AS INTEGER
    playing AS INTEGER
    mood AS INTEGER
    bar AS INTEGER
    heat AS INTEGER
END TYPE

TYPE Game
    mode AS INTEGER
    modeT AS SINGLE
    clock AS SINGLE
    scroll AS SINGLE
    score AS INTEGER
    best AS INTEGER
    newBest AS INTEGER
    trail AS SINGLE
    toTitle AS INTEGER
    quitting AS INTEGER
END TYPE

TYPE World
    g AS Game
    m AS Moth
    fx AS Fx
    sky AS Sky
    song AS Song
    page AS INTEGER
END TYPE

TYPE Pad
    flap AS INTEGER
    mute AS INTEGER
    back AS INTEGER
END TYPE

TYPE Look
    sc AS INTEGER
    c1 AS INTEGER
    c2 AS INTEGER
    sh AS INTEGER
END TYPE

TYPE Ridge
    speed AS SINGLE
    c AS INTEGER
    d1 AS INTEGER
    d2 AS INTEGER
    band AS INTEGER
    bottom AS INTEGER
    stp AS INTEGER
END TYPE

