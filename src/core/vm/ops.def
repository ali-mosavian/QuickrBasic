/* The instruction set, for the compiler and the VM. Include it after defining OP, XOP, K or FRAME;
 * each is undefined at the end.
 *
 * OP(name, handler, size, flags): op O_name, its handler, its bytes with the op (0 varies: ON,
 * S.LD.TXT, see flow_opsize), FX an expression's op, FV a variable's VCELL after the op (exec.h), FV2
 * and FV3 a second and third after it (a fused op's), FB
 * the handler serves several ops and reads which at vm.opip, FK pure: the stack alone, so a
 * constant expression runs as it compiles (comp/fold.h), FP a scalar parameter's id after the op, its
 * ref cell's offset in the frame once linked, FA an array's or a record's id after the op, then its
 * cell as link resolved it (VCELL, a Loc: mem/loc.h).
 *
 * TWIN(name, twin, handler, twin's handler, size, flags, place): two ops of one size, O_name with
 * the place flag (FV, FA) and O_twin its form on a variable in the frame (comp/select.c): its
 * operand an offset from the frame, not a cell. FRAME(name, twin) gets each pair.
 *
 * An op's number is the golden code's: a new op takes the slot of one moved behind X; a new X op
 * goes last.
 *
 * XOP(name, handler, size, flags): X op X_name, O_X then its byte, size counting both: the less hot
 * ops. None names a variable (FV, FA, FP) or reads its op (FB).
 *
 * L ops: a LONG, the cell's 8 bytes signed; UL a ULONG's; U a UINT's 32 bits; LW and IW wrap a
 * LONG's or an INT's bits. A LONG's loads and stores are a DOUBLE's.
 *
 * K(name, handler): the CALL op's routine K_name. The statements' first, from K_IPOW an
 * expression's; K_FN_SGN .. K_FN_CHRS are SGN .. CHR$ by token (TK_SGN ..), all func_fn1.
 *
 * A handler is `void h(Session *S)`: its operands at vm.ip, its values on vm.sp. Another group's
 * handlers are named in its portmap (num: dubl_*; io: file_*).
 *
 * # asm structure (retired/asm32/vm/isa.inc)
 * | asm | here | |
 * |---|---|---|
 * | oplist, O_*, O_NOPS | OP(...), O_*, O_NOPS (exec.h) | MIRROR; D1 |
 * | qbklist, K_*, K_N, K_FN, K_LEFT, K_MID2 | K(...), K_*, K_N, K_FN (= K_FN_SGN), K_LEFT, K_MID2 (exec.h) | MIRROR |
 * | FX, FV, FB | FX, FV, FB (exec.h) | MIRROR |
 *
 * - D1. I.EQV, I.IMP, D.POW, P.REFN, F.TOB, F.TOA, D.NZ, S.IF, F.IF, D.PAST, ONEV, ONERR, ONLERR,
 *   RESUME, RESTORE.L, RUN.L, R.COPY, MODEND, I.PAST, F.PAST, SF.LD, SF.ST, ERR and D.TOI are X ops;
 *   F.LD.PI, never made, is gone.
 */

#if defined(OP) || defined(FRAME)
#ifndef OP
#define OP(name, handler, size, flags)
#endif
#ifndef FRAME
#define FRAME(name, twin)
#endif
#define TWIN(name, twin, handler, thandler, size, flags, place)                                    \
    OP(name, handler, size, (flags) + (place))                                                     \
    OP(twin, thandler, size, flags)                                                                \
    FRAME(name, twin)

OP(EOL, flow_eol, 1, 0)
TWIN(I_LD_V, I_LD_L, oper_i_ld_v, oper_i_ld_l, 1 + VCELL, FX, FV)
OP(I_LD_I16, oper_i_ld_i16, 3, FX + FK)
OP(I_LD_U8, oper_i_ld_u8, 2, FX + FK)
OP(I_LD_I32, oper_i_ld_i32, 5, FX + FK)
TWIN(I_LD_A1, I_LD_A1F, exec_i_ld_a1, exec_i_ld_a1f, 1 + VID + VCELL, FX, FA)
OP(I_LD_A, exec_i_ld_a, 2 + VID + VCELL, FX + FA)
TWIN(F_LD_V, F_LD_L, oper_i_ld_v, oper_i_ld_l, 1 + VCELL, FX, FV)
TWIN(F_LD_VI, F_LD_LI, oper_f_ld_vi, oper_f_ld_li, 1 + VCELL, FX, FV)
OP(F_LD_F32, oper_f_ld_f32, 5, FX + FK)
OP(F_LD_U8, oper_f_ld_u8, 2, FX + FK)
TWIN(F_LD_A1, F_LD_A1F, exec_f_ld_a1, exec_f_ld_a1f, 1 + VID + VCELL, FX, FA)
OP(F_LD_A, exec_i_ld_a, 2 + VID + VCELL, FX + FA)
TWIN(S_LD_V, S_LD_L, oper_s_ld_v, oper_s_ld_l, 1 + VCELL, FX, FV)
OP(S_LD_TXT, exec_s_ld_txt, 6, FX)
TWIN(S_LD_A1, S_LD_A1F, exec_s_ld_a1, exec_s_ld_a1f, 1 + VID + VCELL, FX, FA)
OP(S_LD_A, exec_s_ld_a, 2 + VID + VCELL, FX + FA)
OP(L_TO_V, oper_l_to_v, 2 + VCELL, FV) /* LONG x op= the popped value: x k (exec.h LTO_*) */
TWIN(I_ST_V, I_ST_L, oper_i_st_v, oper_i_st_l, 1 + VCELL, 0, FV)
TWIN(F_ST_V, F_ST_L, oper_f_st_v, oper_f_st_l, 1 + VCELL, 0, FV)
TWIN(S_ST_V, S_ST_L, exec_s_st_v, exec_s_st_l, 1 + VCELL, 0, FV)
TWIN(I_ST_A1, I_ST_A1F, exec_i_st_a1, exec_i_st_a1f, 1 + VID + VCELL, 0, FA)
TWIN(F_ST_A1, F_ST_A1F, exec_f_st_a1, exec_f_st_a1f, 1 + VID + VCELL, 0, FA)
TWIN(S_ST_A1, S_ST_A1F, exec_s_st_a1, exec_s_st_a1f, 1 + VID + VCELL, 0, FA)
OP(I_ST_A, exec_i_st_a, 2 + VID + VCELL, FA)
OP(F_ST_A, exec_f_st_a, 2 + VID + VCELL, FA)
OP(S_ST_A, exec_s_st_a, 2 + VID + VCELL, FA)
OP(I_ADD, oper_i_add, 1, FX + FK)
OP(I_SUB, oper_i_sub, 1, FX + FK)
OP(I_MUL, oper_i_mul, 1, FX + FK)
OP(I_DIV, oper_i_div, 1, FX + FK)
OP(I_AND, oper_i_and, 1, FX + FK)
OP(I_OR, oper_i_or, 1, FX + FK)
TWIN(I_ADD_V, I_ADD_L, oper_i_add_v, oper_i_add_l, 1 + VCELL, FX, FV)
TWIN(I_SUB_V, I_SUB_L, oper_i_sub_v, oper_i_sub_l, 1 + VCELL, FX, FV)
TWIN(I_MUL_V, I_MUL_L, oper_i_mul_v, oper_i_mul_l, 1 + VCELL, FX, FV)
TWIN(I_DIV_V, I_DIV_L, oper_i_div_v, oper_i_div_l, 1 + VCELL, FX, FV)
TWIN(I_AND_V, I_AND_L, oper_i_and_v, oper_i_and_l, 1 + VCELL, FX, FV)
TWIN(I_OR_V, I_OR_L, oper_i_or_v, oper_i_or_l, 1 + VCELL, FX, FV)
OP(I_ADD_U8, oper_i_add_u8, 2, FX + FK)
OP(I_SUB_U8, oper_i_sub_u8, 2, FX + FK)
OP(I_MUL_U8, oper_i_mul_u8, 2, FX + FK)
OP(I_DIV_U8, oper_i_div_u8, 2, FX + FK)
OP(I_AND_U8, oper_i_and_u8, 2, FX + FK)
OP(I_OR_U8, oper_i_or_u8, 2, FX + FK)
OP(I_NEG, oper_i_neg, 1, FX + FK)
OP(I_NOT, oper_i_not, 1, FX + FK)
OP(F_ADD, oper_f_add, 1, FX + FB + FK)
OP(F_SUB, oper_f_sub, 1, FX + FB + FK)
OP(F_MUL, oper_f_mul, 1, FX + FB + FK)
OP(F_DIV, oper_f_div, 1, FX + FB + FK)
TWIN(F_ADD_V, F_ADD_L, oper_f_add_v, oper_f_add_l, 1 + VCELL, FX + FB, FV)
TWIN(F_SUB_V, F_SUB_L, oper_f_sub_v, oper_f_sub_l, 1 + VCELL, FX + FB, FV)
TWIN(F_MUL_V, F_MUL_L, oper_f_mul_v, oper_f_mul_l, 1 + VCELL, FX + FB, FV)
TWIN(F_DIV_V, F_DIV_L, oper_f_div_v, oper_f_div_l, 1 + VCELL, FX + FB, FV)
TWIN(F_ADD_VI, F_ADD_LI, oper_f_add_vi, oper_f_add_li, 1 + VCELL, FX + FB, FV)
TWIN(F_SUB_VI, F_SUB_LI, oper_f_sub_vi, oper_f_sub_li, 1 + VCELL, FX + FB, FV)
TWIN(F_MUL_VI, F_MUL_LI, oper_f_mul_vi, oper_f_mul_li, 1 + VCELL, FX + FB, FV)
TWIN(F_DIV_VI, F_DIV_LI, oper_f_div_vi, oper_f_div_li, 1 + VCELL, FX + FB, FV)
OP(F_ADD_U8, oper_f_add_u8, 2, FX + FB + FK)
OP(F_SUB_U8, oper_f_sub_u8, 2, FX + FB + FK)
OP(F_MUL_U8, oper_f_mul_u8, 2, FX + FB + FK)
OP(F_DIV_U8, oper_f_div_u8, 2, FX + FB + FK)
OP(F_ADD_F32, oper_f_add_f32, 5, FX + FB + FK)
OP(F_SUB_F32, oper_f_sub_f32, 5, FX + FB + FK)
OP(F_MUL_F32, oper_f_mul_f32, 5, FX + FB + FK)
OP(F_DIV_F32, oper_f_div_f32, 5, FX + FB + FK)
OP(F_NEG, oper_f_neg, 1, FX + FK)
OP(I_CMP, oper_i_cmp, 2, FX + FB + FK)
TWIN(I_CMP_V, I_CMP_L, oper_i_cmp_v, oper_i_cmp_l, 2 + VCELL, FX + FB, FV)
OP(I_CMP_U8, oper_i_cmp_u8, 3, FX + FB + FK)
OP(F_CMP, oper_f_cmp, 2, FX + FB + FK)
TWIN(F_CMP_V, F_CMP_L, oper_f_cmp_v, oper_f_cmp_l, 2 + VCELL, FX + FB, FV)
TWIN(F_CMP_VI, F_CMP_LI, oper_f_cmp_vi, oper_f_cmp_li, 2 + VCELL, FX + FB, FV)
OP(F_CMP_U8, oper_f_cmp_u8, 3, FX + FB + FK)
OP(F_CMP_F32, oper_f_cmp_f32, 6, FX + FB + FK)
OP(S_CMP, exec_s_cmp, 2, FX + FB)
OP(I_CMPIF, oper_i_cmpif, 2, FB)
TWIN(I_CMPIF_V, I_CMPIF_L, oper_i_cmpif_v, oper_i_cmpif_l, 2 + VCELL, FB, FV)
OP(I_CMPIF_U8, oper_i_cmpif_u8, 3, FB)
OP(F_CMPIF, oper_f_cmpif, 2, FB)
TWIN(F_CMPIF_V, F_CMPIF_L, oper_f_cmpif_v, oper_f_cmpif_l, 2 + VCELL, FB, FV)
TWIN(F_CMPIF_VI, F_CMPIF_LI, oper_f_cmpif_vi, oper_f_cmpif_li, 2 + VCELL, FB, FV)
OP(F_CMPIF_U8, oper_f_cmpif_u8, 3, FB)
OP(F_CMPIF_F32, oper_f_cmpif_f32, 6, FB)
OP(S_CMPIF, exec_s_cmp, 2, FB)
OP(I_IF, oper_i_if, 1, 0)
/* Quickr's NEXT (comp/fuse.c): never past an INT's range */
OP(I_COUNT_UP, flow_i_count_up, NEXT_SIZE, FV + FV2 + FV3)
OP(I_TOL, oper_i_tol, 1, FX + FK) /* an INT as a LONG */
OP(S_CAT, exec_s_cat, 1, FX)
OP(I_TOF, oper_i_tof, 1, FX + FK)
OP(F_TOI, oper_f_toi, 1, FX + FK)
TWIN(L_MUL_V, L_MUL_L, oper_l_mul_v, oper_l_mul_l, 1 + VCELL, FX, FV)
OP(I_TOB, oper_i_tob, 1, FX + FK)
OP(I_TOA, oper_i_toa, 1, FX + FK)
OP(DROP, oper_drop, 1, FX)
OP(CALL, exec_call, 2, 0)
OP(GOTO, flow_goto, 1 + sizeof(LineRef), 0)
OP(GOSUB, flow_gosub, 1 + sizeof(LineRef), 0)
TWIN(L_SUB_V, L_SUB_L, oper_l_sub_v, oper_l_sub_l, 1 + VCELL, FX, FV)
OP(ON, flow_on, 0, 0)
OP(RETURN, flow_return, 1, 0)
TWIN(I_STEP_V, I_STEP_L, oper_i_step_v, oper_i_step_l, 1 + VCELL, FX, FV)
/* a narrow field of a record in cells, a variable of its own (qr/qlink.c): cell et */
TWIN(N_LD_V, N_LD_L, exec_n_ld_v, exec_n_ld_l, 2 + VCELL, FX, FV)
OP(P_FL_LD, exec_p_fl_ld, 4 + VID, FX + FP) /* a record parameter's number field: off:2 et */
OP(JMP, flow_jmp, JSIZE, 0)
OP(I_JF, flow_i_jf, JSIZE, 0)
OP(F_JF, flow_f_jf, JSIZE, 0)
OP(I_JT, flow_i_jt, JSIZE, 0)
OP(F_JT, flow_f_jt, JSIZE, 0)
OP(NXLN, flow_nextln, 1, 0)
OP(PCALL, flow_pcall, PCALL_SIZE, 0) /* proc, its locals' cells and parameters (link's), body's Jump */
OP(PRET, flow_pret, 5 + VCELL, 0) /* proc; link's: a FUNCTION's result's cell, or PRET.X */
OP(I_MOD, oper_i_mod, 1, FX + FK)
OP(I_XOR, oper_i_xor, 1, FX + FK)
TWIN(L_ADD_V, L_ADD_L, oper_l_add_v, oper_l_add_l, 1 + VCELL, FX, FV)
OP(R_ADDR, exec_r_addr, 1 + VID + VCELL, FA)
OP(RA_ADDR, exec_ra_addr, 2 + VID + VCELL, FA)
OP(FL_LD, exec_fl_ld, 4, 0)
OP(FL_ST, exec_fl_st, 4, 0)
TWIN(N_ST_V, N_ST_L, exec_n_st_v, exec_n_st_l, 2 + VCELL, 0, FV)
OP(L_TO_L, oper_l_to_l, 2 + VCELL, 0)
FRAME(L_TO_V, L_TO_L)
TWIN(L_JFC_V, L_JFC_L, flow_l_jfc_v, flow_l_jfc_l, 2 + VCELL + sizeof(Jump), 0, FV)
OP(L_JFC, flow_l_jfc, 2 + sizeof(Jump), 0)
OP(I_CHK16, exec_i_chk16, 1, FX + FK)
OP(L_CMP, oper_l_cmp, 2, FX + FK)
TWIN(D_LD_V, D_LD_L, dubl_ldv, oper_d_ld_l, 1 + VCELL, FX, FV)
TWIN(D_ST_V, D_ST_L, dubl_stv, oper_d_st_l, 1 + VCELL, 0, FV)
OP(D_LD_K, dubl_ldk, 9, FX + FK)
TWIN(D_LD_A1, D_LD_A1F, dubl_lda1, dubl_lda1f, 1 + VID + VCELL, FX, FA)
OP(D_LD_A, dubl_lda, 2 + VID + VCELL, FX + FA)
TWIN(D_ST_A1, D_ST_A1F, dubl_sta1, dubl_sta1f, 1 + VID + VCELL, 0, FA)
OP(D_ST_A, dubl_sta, 2 + VID + VCELL, FA)
OP(D_ADD, dubl_add, 1, FX + FK)
OP(D_SUB, dubl_sub, 1, FX + FK)
OP(D_MUL, dubl_mul, 1, FX + FK)
OP(D_DIV, dubl_div, 1, FX + FK)
OP(D_NEG, dubl_neg, 1, FX + FK)
OP(D_CMP, dubl_cmp, 2, FX + FK)
OP(L_MUL, oper_l_mul, 1, FX + FK)
OP(I_TOD, dubl_itod, 1, FX + FK)
OP(F_TOD, dubl_ftod, 1, FX + FK)
OP(D_TOF, dubl_tof, 1, FX + FK)
OP(P_FL_ST, exec_p_fl_st, 4 + VID, FP)
OP(D_FN, dubl_fn, 2, FX)
OP(L_ADD, oper_l_add, 1, FX + FK)
OP(DBG, dbug_dbg, 1, 0)
OP(P_REF, exec_p_ref, 3, 0)
OP(V_ADDR, exec_v_addr, 1 + VID, FP)
TWIN(V_CELL, L_CELL, oper_s_ld_v, oper_s_ld_l, 1 + VCELL, FX, FV) /* a scalar's cell, as S.LD.V a descriptor's */
OP(V_LD, exec_v_ld, 2 + VID, FX + FP)
OP(V_ST, exec_v_st, 2 + VID, FP)
OP(SYSCALL, sysc_call, 2, 0) /* the runtime's service n (vm/syscalls.def) */
OP(I_COUNT_DN, flow_i_count_dn, NEXT_SIZE, FV + FV2 + FV3)
/* fused (comp/fuse.c), no asm counterpart */
OP(I_NEXT_UP, flow_i_next_up, NEXT_SIZE, FV + FV2 + FV3)
OP(I_NEXT_DN, flow_i_next_dn, NEXT_SIZE, FV + FV2 + FV3)
OP(I_MOD_U8, oper_i_mod_u8, 2, FX)
OP(I_ADD_I16, oper_i_add_i16, 3, FX)
OP(I_SUB_I16, oper_i_sub_i16, 3, FX)
OP(I_MUL_I16, oper_i_mul_i16, 3, FX)
OP(I_DIV_I16, oper_i_div_i16, 3, FX)
OP(I_AND_I16, oper_i_and_i16, 3, FX)
OP(I_OR_I16, oper_i_or_i16, 3, FX)
OP(I_MOD_I16, oper_i_mod_i16, 3, FX)
OP(I_CMP_I16, oper_i_cmp_i16, 4, FX)
OP(I_JFC, flow_i_jfc, 2 + sizeof(Jump), 0)
TWIN(I_JFC_V, I_JFC_L, flow_i_jfc_v, flow_i_jfc_l, 2 + VCELL + sizeof(Jump), 0, FV)
OP(I_JFC_U8, flow_i_jfc_u8, 3 + sizeof(Jump), 0)
OP(I_JFC_I16, flow_i_jfc_i16, 4 + sizeof(Jump), 0)
OP(I_ADD_V_ST, oper_i_add_v_st, 3 * VCELL + 1, FV + FV2 + FV3)
OP(I_SUB_V_ST, oper_i_sub_v_st, 3 * VCELL + 1, FV + FV2 + FV3)
OP(I_MUL_V_ST, oper_i_mul_v_st, 3 * VCELL + 1, FV + FV2 + FV3)
OP(I_DIV_V_ST, oper_i_div_v_st, 3 * VCELL + 1, FV + FV2 + FV3)
OP(I_AND_V_ST, oper_i_and_v_st, 3 * VCELL + 1, FV + FV2 + FV3)
OP(I_OR_V_ST, oper_i_or_v_st, 3 * VCELL + 1, FV + FV2 + FV3)
OP(I_ADD_U8_ST, oper_i_add_u8_st, 2 * VCELL + 2, FV + FV2)
OP(I_SUB_U8_ST, oper_i_sub_u8_st, 2 * VCELL + 2, FV + FV2)
