OP(I_OR_I16_ST, oper_i_or_i16_st, 2 * VCELL + 3, FV + FV2)
OP(I_MOD_I16_ST, oper_i_mod_i16_st, 2 * VCELL + 3, FV + FV2)
OP(I_SET_U8, oper_i_set_u8, 2 + VCELL, FV)
OP(I_SET_I16, oper_i_set_i16, 3 + VCELL, FV)
OP(I_SET_I32, oper_i_set_i32, 5 + VCELL, FV)
OP(I_MOV, oper_i_mov, 1 + 2 * VCELL, FV + FV2)
/* link_xlate's line end of a stored line: the next line, its code; 0 none */
OP(EOL_TO, flow_eol, EOL_TO_SIZE, 0)
OP(BYVAL, exec_byval, 2, 0)
OP(PRET_FV, flow_pret_fv, 5 + VCELL, 0) /* a FUNCTION's number, its result a cell */
