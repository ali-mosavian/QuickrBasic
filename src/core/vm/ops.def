XOP(L_TOI, oper_l_toi, 2, FX + FK)
XOP(L_TOD, oper_l_tod, 2, FX + FK)
XOP(D_TOL, oper_d_tol, 2, FX + FK) /* toward 0 */
XOP(U_TOL, oper_u_tol, 2, FX + FK)
XOP(LW_ADD, oper_lw_add, 2, FX + FK)
XOP(LW_SUB, oper_lw_sub, 2, FX + FK)
XOP(LW_MUL, oper_lw_mul, 2, FX + FK)
XOP(LW_NEG, oper_lw_neg, 2, FX + FK)
