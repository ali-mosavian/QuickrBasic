XOP(UL_SUB, oper_ul_sub, 2, FX + FK)
XOP(UL_MUL, oper_ul_mul, 2, FX + FK)
XOP(UL_DIV, oper_ul_div, 2, FX + FK)
XOP(UL_MOD, oper_ul_mod, 2, FX + FK)
XOP(UL_CMP, oper_ul_cmp, 3, FX + FK)
XOP(UL_SHR, oper_ul_shr, 2, FX + FK)
XOP(U_ADD, oper_u_add, 2, FX + FK)
XOP(U_SUB, oper_u_sub, 2, FX + FK)
XOP(U_MUL, oper_u_mul, 2, FX + FK)
XOP(U_DIV, oper_u_div, 2, FX + FK)
XOP(U_MOD, oper_u_mod, 2, FX + FK)
XOP(U_CMP, oper_u_cmp, 3, FX + FK)
