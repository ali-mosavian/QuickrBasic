OP(PRET_X, flow_pret_x, 5 + VCELL, 0)   /* a string result */ /* the address of the value on top, a string's copied there */
OP(I_CHK8, exec_i_chk8, 1, FX + FK)
/* fused ops on a frame's locals alone: each cell an offset from the frame */
OP(I_NEXT_UP_L, flow_i_next_up_l, NEXT_SIZE, 0)
FRAME(I_NEXT_UP, I_NEXT_UP_L)
OP(I_NEXT_DN_L, flow_i_next_dn_l, NEXT_SIZE, 0)
FRAME(I_NEXT_DN, I_NEXT_DN_L)
OP(N_LD_A, exec_n_ld_a, 3 + VID + VCELL, FX + FA) /* a SHORT or BYTE array's element: id cell n et */
OP(N_ST_A, exec_n_st_a, 3 + VID + VCELL, FA)
OP(I_COUNT_UP_L, flow_i_count_up_l, NEXT_SIZE, 0)
FRAME(I_COUNT_UP, I_COUNT_UP_L)
OP(V_REF, exec_v_ref, 1 + VID, FP)  /* a parameter's ref, passed on */
OP(FE_ADDR, exec_fe_addr, 10, 0)    /* a record's array field's element ( a s.. -- e ): off:4 n esize:4 */
OP(FX_IDX, exec_fx_idx, 13, 0)      /* a fixed array field's element ( a s -- e ): lb count stride */
OP(E_NEXT, flow_e_next, E_NEXT_SIZE, 0) /* for x in a's next: i, a and x Locs (comp/select.c), a Jump */
OP(I_COUNT_DN_L, flow_i_count_dn_l, NEXT_SIZE, 0)
FRAME(I_COUNT_DN, I_COUNT_DN_L)
OP(X, exec_x, 0, 0) /* an X op: its byte next (XOP) */
#undef TWIN
#undef FRAME
#undef OP
#endif

#ifdef XOP
XOP(I_EQV, oper_i_eqv, 2, FX + FK)
XOP(I_IMP, oper_i_imp, 2, FX + FK)
XOP(D_POW, dubl_pow, 2, FX)
