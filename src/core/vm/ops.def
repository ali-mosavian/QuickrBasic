OP(I_DIV_U8_ST, oper_i_div_u8_st, 2 * VCELL + 2, FV + FV2)
OP(I_AND_U8_ST, oper_i_and_u8_st, 2 * VCELL + 2, FV + FV2)
OP(I_OR_U8_ST, oper_i_or_u8_st, 2 * VCELL + 2, FV + FV2)
OP(I_MOD_U8_ST, oper_i_mod_u8_st, 2 * VCELL + 2, FV + FV2)
OP(I_ADD_I16_ST, oper_i_add_i16_st, 2 * VCELL + 3, FV + FV2)
OP(I_SUB_I16_ST, oper_i_sub_i16_st, 2 * VCELL + 3, FV + FV2)
