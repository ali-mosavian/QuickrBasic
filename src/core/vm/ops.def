XOP(IW_SUB, oper_iw_sub, 2, FX + FK)
XOP(IW_MUL, oper_iw_mul, 2, FX + FK)
XOP(IW_NEG, oper_iw_neg, 2, FX + FK)
XOP(N_CONV, qrt_conv, 4, FX + FK) /* any integer or float as another: from, to and wrap (qr/qrt.h) */
XOP(S_JOIN, exec_s_join, 3, FX)     /* n strings joined, one allocation: n */
XOP(IMPORT, flow_import, 10, 0)   /* ours: a module's code run, once (comp/import.c): module:4 line:4 */
XOP(I_PAST, flow_i_past, 2, FX)
XOP(F_PAST, flow_f_past, 2, FX)
XOP(SF_LD, exec_sf_ld, 6, 0)
XOP(SF_ST, exec_sf_st, 6, 0)
XOP(ERR, flow_err, sizeof(ErrOp), 0)
XOP(D_TOI, dubl_toi, 2, FX + FK)
XOP(F_IF, oper_f_if, 2, 0)
XOP(L_SUB, oper_l_sub, 2, FX + FK)
XOP(L_ADD_U8, oper_l_add_u8, 3, FX + FK)
XOP(L_SUB_U8, oper_l_sub_u8, 3, FX + FK)
/* Quickr's NEXT unfused ( n lim step -- go n' ): k (exec.h COUNT_*) */
XOP(I_COUNT, flow_i_count, 3, 0)
XOP(HOLD, stmt_hold, 2, 0) /* ours: a call while addresses into the heap wait on the stack */
XOP(UNHOLD, stmt_unhold, 2, 0)
#undef XOP
#endif

