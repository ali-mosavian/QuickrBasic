/* The runtime's services (O_SYSCALL n): each call's number SC_name and its handler. Include it
 * after defining SC; it is undefined at the end.
 *
 * SC(name, handler): a handler is `void h(Session *S)`, its arguments on vm.sp, the last pushed
 * first popped. An argument left out is -1, the runtime's "none". Append: a number is code.
 */
#ifdef SC
SC(N1, vgfx_n1)         /* ( x y -- ): the first point */
SC(S1, vgfx_s1)         /* ( dx dy -- ): the first point, STEP from the last */
SC(N2, vgfx_n2)         /* ( x y -- ): the second point */
SC(S2, vgfx_s2)         /* ( dx dy -- ): the second point, STEP from the first */
SC(SCREEN, vgfx_screen) /* ( (value given) * 4 -- ): SCREEN mode, colorswitch, apage, vpage */
SC(PSET, vgfx_pset)     /* ( -- ): PSET at the first point */
SC(PRESET, vgfx_preset) /* ( -- ): PRESET there */
SC(PSETC, vgfx_psetc)   /* ( color -- ): PSET or PRESET there in color */
SC(LINE, vgfx_line)     /* ( color how style -- ): LINE between the points; how 0, 1 B, 2 BF */
SC(CSTART, vgfx_cstart) /* ( start -- ): the next CIRCLE's start angle */
SC(CEND, vgfx_cend)     /* ( end -- ): its end angle */
SC(CASPECT, vgfx_caspect) /* ( aspect -- ): its aspect */
SC(CIRCLE, vgfx_circle) /* ( radius color -- ): CIRCLE round the first point */
SC(LAST, vgfx_last)     /* ( -- ): the first point the last one */
SC(PAINT, vgfx_paint)   /* ( fill border -- ): PAINT from the first point */
SC(PAINTT, vgfx_paintt) /* ( tile$ border [background$] given -- ): PAINT with a tile */
SC(DRAW, vgfx_draw)     /* ( commands$ -- ) */
SC(VIEW, vgfx_view)     /* ( x1 y1 x2 y2 fill border screen -- ): VIEW [SCREEN] (..)-(..) */
SC(VIEW0, vgfx_view0)   /* ( -- ): VIEW alone, the whole screen */
SC(WINDOW, vgfx_window) /* ( x1 y1 x2 y2 screen -- ): WINDOW [SCREEN] (..)-(..) */
SC(WINDOW0, vgfx_window0) /* ( -- ): WINDOW alone, none */
SC(PALETTE, vgfx_palette) /* ( attribute color -- ) */
SC(PALETTEU, vgfx_paletteu) /* ( id element kind -- ): PALETTE USING array(element) */
SC(GET, vgfx_get)       /* ( id element kind -- ): GET between the points into array(element) */
SC(PUT, vgfx_put)       /* ( id element kind how -- ): PUT at the first point; how 0 OR .. 4 XOR */
SC(POINT, vgfx_point)   /* ( x y -- color ): POINT(x, y), -1 off the screen */
SC(PMAP, vgfx_pmap)     /* ( value function -- mapped ) */
SC(CLS, vgfx_cls)       /* ( selector -- ) */
SC(COLOR, vgfx_color)   /* ( (value given) * 3 -- ): COLOR foreground, background, border */
SC(LOCATE, vgfx_locate) /* ( (value given) * 5 -- ): LOCATE row, column, cursor, start, stop */
SC(VIEWPRINT, vgfx_viewprint) /* ( top bottom -- ): VIEW PRINT, -1 -1 the whole screen */
SC(WIDTH, vgfx_width)   /* ( columns rows -- ): the screen's WIDTH, -1 one left out */
SC(BEEP, vgfx_beep)     /* ( -- ) */
SC(CSRLIN, vgfx_csrlin) /* ( -- row ): the cursor's, from 1 */
SC(SOUND, snd_sound)    /* ( hertz ticks -- ) */
SC(PLAY, snd_play)      /* ( commands -- ) */
SC(PLAYN, snd_waiting)  /* ( n -- notes ): PLAY(n), the notes waiting */
SC(STICK, vdev_stick)   /* ( n -- i ): STICK(n) */
SC(STRIG, vdev_strig)   /* ( n -- i ): STRIG(n) */
SC(PEN, vdev_pen)       /* ( n -- i ): PEN(n) */
SC(SCRN, vdev_screen)   /* ( r c [f] count -- i ): SCREEN(r, c[, f]) */
SC(PLAYV, snd_play_voices) /* ( commands... given -- ): PLAY a$, b$, ..., bit n of given voice n's string */
SC(PCOPY, vgfx_pcopy)   /* ( from to -- ): PCOPY */
#undef SC
#endif
