' maps: set, read, in, remove, len, keys, for; records, enums, copies
var ages as int[string]
ages["ada"] = 36
ages["bob"] = 7
ages["cy"] = 12
print(len(ages), ages["bob"])
ages["bob"] += 1
print(ages["bob"], "ada" in ages, "zed" in ages, "zed" not in ages)
for k, v in ages
    print(k, v)
end for
ages.remove("ada")
ages.remove("nope")
print(len(ages))
for k in ages
    print(k)
end for
let ks = ages.keys()
print(len(ks), ks[0])
var sq as int[int]
for i in 0..1000
    sq[i * 7] = i * i
end for
var sum = 0
for i in 0..1000
    sum += sq[i * 7]
end for
print(len(sq), sum, sq[700])
for i in 0..1000
    if i mod 3 <> 0 then
        sq.remove(i * 7)
    end if
end for
var ok = true
for i in 0..1000
    ok = ok and ((i * 7 in sq) = (i mod 3 = 0))
end for
print(len(sq), ok)
var names as string[int]
for i in 0..200
    names[i] = f"n{i}"
end for
print(names[150], len(names))
type Pet
    name as string
    legs as int
    tags as string[]
end type
type Zoo
    pets as Pet[string]
    count as int
end type
enum Color
    red
    green
end enum
fn census(z as Zoo) as int[string]
    var out as int[string]
    for k, p in z.pets
        out[k] = p.legs
    end for
    return out
end fn
fn add(mut z as Zoo, name as string, legs as int)
    z.pets[name] = Pet(name, legs)
    z.pets[name].tags.push(f"{legs} legs")
    z.count += 1
end fn
var zoo as Zoo
add(mut zoo, "rex", 4)
add(mut zoo, "tweety", 2)
add(mut zoo, "nemo", 0)
print(zoo.count, len(zoo.pets), zoo.pets["tweety"].tags[0])
let c = census(zoo)
for k, v in c
    print(k, v)
end for
var z2 = copy(zoo)
z2.pets["rex"].legs = 3
z2.pets.remove("nemo")
print(zoo.pets["rex"].legs, z2.pets["rex"].legs, len(zoo.pets), len(z2.pets))
var paint as string[Color]
paint[Color.green] = "grass"
paint[Color.red] = "rose"
print(paint[Color.red], len(paint))
var big as Pet[int]
for i in 0..60
    big[i] = Pet(f"p{i}", i)
    big[i].tags.push("t")
end for
for i in 0..60
    if i mod 2 = 0 then
        big.remove(i)
    end if
end for
var total = 0
for k, p in big
    total += p.legs + len(p.tags)
end for
print(len(big), total, big[59].name)
var moved = big
print(len(moved))
fn build(n as int) as int
    var m as string[int]
    for i in 0..n
        m[i] = f"v{i}"
    end for
    return len(m)
end fn
fn made(n as int) as int[int]
    var m as int[int]
    for i in 0..n
        m[i] = i
    end for
    return m
end fn
var t = 0
for r in 0..300
    t += build(200)
    let q = made(50)
    t += len(q)
end for
print(t)
for k, v in made(5)
    print(k, v)
end for
print(len(made(9).keys()))
