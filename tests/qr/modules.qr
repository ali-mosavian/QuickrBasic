' modules: import, from, as, packages, public, cycles and their vars' start
import gfx
import pkg.a
import ping
from gfx import plot, Point as P, MAXW, largest
from pkg.b import twice as dbl
import pkg.b as bee
print("main starts", pkg.a.order, bee.order)
plot(400, 3)
gfx.plot(5, 6)
print(gfx.plotted, MAXW, gfx.MAXW)
let p = P(2, 3)
print(p.norm(), gfx.norm(p))
var q as gfx.Point
q.x = 7
print(q.norm())
print(int(gfx.Shade.light), gfx.Shade.dark = gfx.Shade.dark)
print(pkg.a.quad(3), dbl(5), bee.twice(1))
gfx.plotted = 10
print(gfx.plotted)
var xs as int[]
xs.push(3)
xs.push(9)
xs.push(4)
var ss as string[]
ss.push("b")
ss.push("c")
print(largest(xs), gfx.largest(ss))
for e in gfx.evens(5)
    print(e)
end for
print(ping.ping(5))
from pkg import b as bmod
print(bmod.twice(21))
let k = 100
print(gfx.apply(xs, fn(x) x + k), gfx.apply(xs, fn(x) x * MAXW))
