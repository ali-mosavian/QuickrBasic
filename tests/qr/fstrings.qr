' f-strings: Python's format specs
let n = 42
let x = 3.14159
let s = "hi"
print(f"n={n} x={x} s={s} b={true}")
print(f"[{n:5}] [{n:<5}] [{n:^5}] [{n:05}] [{n:+}] [{-n:=6}]")
print(f"[{n:x}] [{n:#x}] [{n:X}] [{n:o}] [{n:b}] [{n:#b}] [{1234567:,}] [{1234567:_}]")
print(f"[{x:.2f}] [{x:8.3f}] [{x:<8.1f}|] [{x:e}] [{x:.3g}] [{0.25:%}] [{0.25:.0%}]")
print(f"[{s:>5}] [{s:*^6}] [{s:.1}] [{"abc"}] {{literal}} [{n * 2 + 1}]")
print(f"{single(x)} {single(x):.3f} {1e20} {12345.678:,.2f}")
print(f"")
print(f"a\tb{n}\n")
print(f"{0.5:.0f} {0.006:.2f} {0.004:.2f} {9.9999:.3g} {123.456:#.3g} {1e-7:g} {0.000123:.3g}")
