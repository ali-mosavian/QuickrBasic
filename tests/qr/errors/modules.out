modules.bas:4:8: no module nope
  import nope
         ^
modules.bas:5:17: hidden is not public in lib
  from lib import hidden, shown, missing
                  ^
modules.bas:5:32: lib has no missing
  from lib import hidden, shown, missing
                                 ^
modules.bas:6:10: lib is already declared
  function lib()
           ^
modules.bas:8:29: hidden is not public in lib
  print lib.shown(); " "; lib.hidden(); " "; lib.count; " "; lib.nothing
                              ^
modules.bas:8:48: count is not public in lib
  print lib.shown(); " "; lib.hidden(); " "; lib.count; " "; lib.nothing
                                                 ^
