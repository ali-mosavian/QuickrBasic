compound.bas:11:5: me holds its own type: hold it in a list
      me as Loop
      ^
compound.bas:17:19: too many values for Vec
  let v = Vec(1, 2, 3)
                    ^
compound.bas:18:13: Vec has no field z
  let w = Vec(z: 1)
              ^
compound.bas:19:9: Vec has no field z
  print v.z
          ^
compound.bas:20:3: v is a let: it can't change
  v.x = 2
    ^
compound.bas:21:7: a Vec has no text(): print can't spell it
  print v
        ^
compound.bas:23:9: a is used after it moves here: write copy(a)
  var b = a
          ^
compound.bas:27:7: c is borrowed by the for over it: it can't change here
      c.push(x)
        ^
compound.bas:28:5: x is the for's element: write for mut x
      x = 2
      ^
compound.bas:31:5: c is borrowed by the for mut over it: reach it through x
      c.remove(0)
      ^
compound.bas:32:15: c is borrowed by the for mut over it: reach it through x
      print len(c); " "; c[0]
                ^
compound.bas:32:24: c is borrowed by the for mut over it: reach it through x
      print len(c); " "; c[0]
                         ^
compound.bas:35:12: bag is used after it moves here: write copy(bag)
  var bag2 = bag
             ^
compound.bas:37:16: only a whole let or var moves: write copy(..)
  var bag3 = bag.items
                 ^
compound.bas:41:1: the select misses jump: give it a case, or add case else
  end select
  ^
compound.bas:51:3: an array's size is fixed
  n.push(1)
    ^
compound.bas:52:9: the index is past the elements
  print n[4]
          ^
compound.bas:56:9: mut v is a Vec, not a single
  g(mut u.x)
          ^
compound.bas:57:12: a Vec has no text(): an f-string can't spell it
  let k = f"{v}"
             ^
compound.bas:58:14: q is no format for an int
  let j = f"{3:q}"
               ^
compound.bas:61:13: ss moves in a loop it is declared outside: write copy(ss)
      var t = ss
              ^
compound.bas:65:10: l1 is used after it moves here: write copy(l1)
  var l3 = l1 if len(l2) > 0 else l2
           ^
