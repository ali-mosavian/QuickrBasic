parse.bas:3:5: expected a name, not =
  let = 3
      ^
parse.bas:4:10: expected a value, not the line's end
  print 1 +
           ^
parse.bas:5:1: if without end if
  if x then
  ^
parse.bas:5:4: unknown name x
  if x then
     ^
parse.bas:6:8: expected the line's end, not )
  print 1) 
         ^
parse.bas:7:7: expected in, not 0
  for i 0..3
        ^
parse.bas:9:1: wend without while
  wend
  ^
parse.bas:11:1: function without end function
  function
  ^
parse.bas:11:9: expected the function's name, not the line's end
  function
          ^
parse.bas:12:1: a value alone is not a statement: assign it or call a function
  x + 1
  ^
parse.bas:14:9: lists are not supported yet
  var s = [1, 2]
          ^
parse.bas:15:1: while without wend
  while true
  ^
