' optionals and errors: their errors
fn f(x as int?) as int
    if x is none then return 0
    return x * 3
end fn
print(f(4), f(none))
let p = none
var q as int = none
fn g() as int
    let r = parse("")?
    return r
end fn
fn parse(s as string) as int!
    return 1
end fn
let e = Error(1, "x")
var w as int? = 3
print(w + 1)
if w is Error then print(1)
print(3 ?? 4)
let u = 5?
var v as int?? = 1
fn h() as string!
    return Error("x", 2)
end fn
var m as int[string]
print(m.get(1))
