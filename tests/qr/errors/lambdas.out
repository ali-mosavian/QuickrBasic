lambdas.bas:19:13: f is a lambda: call it or pass it on
      let g = f
              ^
lambdas.bas:20:24: f is a lambda: call it outside another lambda
      return apply(fn(v) f(v), 2)
                         ^
lambdas.bas:25:17: the lambda takes one value here
      print(apply(fn(a, b) a, 1))
                  ^
lambdas.bas:26:25: + joins two strings: write string(x)
      print(apply(fn(v) v + "s", 1))
                          ^
