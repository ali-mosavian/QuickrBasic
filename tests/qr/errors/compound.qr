' records, enums, lists: their errors
type Vec
    x as single
    y as single
end type
type Bag
    items as int[]
end type
type Loop
    me as Loop
end type
enum Mode
    walk
    jump
end enum
let v = Vec(1, 2, 3)
let w = Vec(z: 1)
print(v.z)
v.x = 2
print(v)
var a as int[]
var b = a
a.push(1)
var c as int[]
for x in c
    c.push(x)
    x = 2
end for
for mut x in c
    c.remove(0)
    print(len(c), c[0])
end for
var bag as Bag
var bag2 = bag
print(bag.items[0])
var bag3 = bag.items
match Mode.walk
    case Mode.walk
        print(1)
end match
fn f(m as Mode) as int
    match m
        case Mode.walk
            return 1
        case Mode.jump
            return 2
    end match
end fn
var n as int[4]
n.push(1)
print(n[4])
fn g(mut v as Vec)
end fn
var u = Vec(1, 2)
g(mut u.x)
let k = f"{v}"
let j = f"{3:q}"
var ss as int[]
for i in 0..3
    var t = ss
end for
