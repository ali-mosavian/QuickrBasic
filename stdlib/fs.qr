' fs: files, each error a value. A File stays open until close(): there is no drop yet.
import text

native fn file_open(path as string, mode as string) as int
native fn file_read(n as int, count as int) as string
native fn file_write(n as int, s as string) as int
native fn file_seek(n as int, at as int) as int
native fn file_size(n as int) as int
native fn file_close(n as int)
native fn file_list(pattern as string) as string
native fn error_text(err as int) as string

' an open file: its number, as OPEN's
public type File
    n as int
end type

' path opened: mode "r" to read, "w" to write it anew, "a" to add to its end, "rw" both
public fn open(path as string, mode as string = "r") as File!
    let n = file_open(path, mode)
    if n < 0 then return Error(-n, f"{path}: {error_text(-n)}")
    return File(n)
end fn

' count bytes at most from f's place, fewer at its end
public fn read(f as File, count as int) as string
    return file_read(f.n, count)
end fn

public fn write(f as File, s as string) as bool!
    let st = file_write(f.n, s)
    if st < 0 then return Error(-st, f"write: {error_text(-st)}")
    return true
end fn

' f's place to byte at, from 0
public fn seek(f as File, at as int) as bool!
    let st = file_seek(f.n, at)
    if st < 0 then return Error(-st, f"seek: {error_text(-st)}")
    return true
end fn

public fn size(f as File) as int
    return file_size(f.n)
end fn

public fn close(f as File)
    file_close(f.n)
end fn

' the whole file as a string
public fn read_text(path as string) as string!
    let f = open(path)?
    let s = read(f, size(f))
    close(f)
    return s
end fn

public fn write_text(path as string, s as string) as bool!
    let f = open(path, "w")?
    let st = file_write(f.n, s)
    close(f)
    if st < 0 then return Error(-st, f"{path}: {error_text(-st)}")
    return true
end fn

' the names of the files matching pattern, wildcards * and ?
public fn list(pattern as string = "*.*") as string[]
    var names = text.split(file_list(pattern), text.chr(10))
    names.pop()
    return names
end fn
