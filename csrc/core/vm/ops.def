/* The instruction set, for the compiler and the VM. Include it after defining OP and/or K; each
 * is undefined at the end.
 *
 * OP(name, handler, size, flags): op O_name, its handler, its bytes with the op (0 varies: ON,
 * S.LD.TXT, see flow_opsize), FX an expression's op, FV a variable's VCELL after the op (exec.h), FV2
 * and FV3 a second and third after it (a fused op's), FB
 * the handler serves several ops and reads which at vm.opip, FK pure: the stack alone, so a
 * constant expression runs as it compiles (comp/fold.h), FP a scalar parameter's id after the op, its
 * ref cell's offset in the frame once linked.
 *
 * K(name, handler): the CALL op's routine K_name. The statements' first, from K_IPOW an
 * expression's; K_FN_SGN .. K_FN_CHRS are SGN .. CHR$ by token (TK_SGN ..), all func_fn1.
 *
 * A handler is `void h(Session *S)`: its operands at vm.ip, its values on vm.sp. Another group's
 * handlers are named in its portmap (num: dubl_*; io: file_*).
 *
 * # asm structure (src/vm/isa.inc)
 * | asm | here | |
 * |---|---|---|
 * | oplist, O_*, O_NOPS | OP(...), O_*, O_NOPS (exec.h) | MIRROR |
 * | qbklist, K_*, K_N, K_FN, K_LEFT, K_MID2 | K(...), K_*, K_N, K_FN (= K_FN_SGN), K_LEFT, K_MID2 (exec.h) | MIRROR |
 * | FX, FV, FB | FX, FV, FB (exec.h) | MIRROR |
 */

#ifdef OP
